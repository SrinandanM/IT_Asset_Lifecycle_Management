<mvc:View
    controllerName="asset.lifecycle.portal.adminportal.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.data="sap.viz.ui5.data"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
    displayBlock="true"
    height="100%">

    <Page
        id="portalPage"
        title="Enterprise Asset Lifecycle Management"
        showNavButton="false"
        enableScrolling="false">
        
        <content>
            <HBox id="mainLayout" width="100%" height="100%" alignItems="Stretch">

                <!-- LEFT NAVIGATION -->
                <List
                    id="navigationMenu"
                    width="280px"
                    mode="SingleSelectMaster"
                    selectionChange=".onMenuSelect"
                    includeItemInSelection="true">
                    <StandardListItem id="dashboardItem" title="Dashboard" icon="sap-icon://home" type="Active" />
                    <StandardListItem id="assetsItem" title="Assets" icon="sap-icon://laptop" type="Active" />
                    <StandardListItem id="requestsItem" title="Asset Requests" icon="sap-icon://workflow-tasks" type="Active" />
                    <StandardListItem id="employeesItem" title="Employees" icon="sap-icon://employee" type="Active" />
                    <StandardListItem id="departmentsItem" title="Departments" icon="sap-icon://building" type="Active" />
                    <StandardListItem id="vendorsItem" title="Vendors" icon="sap-icon://supplier" type="Active" />
                    <StandardListItem id="categoriesItem" title="Categories" icon="sap-icon://tag" type="Active" />
                    <StandardListItem id="reportsItem" title="Reports" icon="sap-icon://business-objects-experience" type="Active" />
                </List>

                <!-- RIGHT CONTENT -->
                <VBox id="contentArea" width="100%" height="100%">

                    <!-- DASHBOARD -->
<VBox id="dashboardContainer" visible="true" class="dashboard-wrapper">
    
    <!-- NEW: Blue Header Banner -->
    <VBox class="blue-header-banner">
        <VBox id="headerBox" class="dashboardHeader">
            <Title id="dashboardTitle" text="Enterprise Asset Management Dashboard" level="H1" class="sectionTitle"/>
            <Text id="dashboardSubTitle" text="Real-Time Asset Lifecycle Monitoring" class="sectionSubtitle"/>
        </VBox>
    </VBox>

    <VBox id="dashboardVBox">
        <HBox id="kpiHBox" wrap="Wrap" class="kpiGrid" justifyContent="Start">
            <GenericTile id="tileTotal" header="Total Assets" subheader="All registered assets" class="kpiCard">
                <TileContent><NumericContent value="{dashboard>/totalAssets}" withMargin="false" icon="sap-icon://inventory" valueColor="Neutral" /></TileContent>
            </GenericTile>
            <GenericTile id="tileAvailable" header="Available" subheader="Ready to assign" class="kpiCard">
                <TileContent><NumericContent value="{dashboard>/availableAssets}" withMargin="false" icon="sap-icon://accept" valueColor="Good" /></TileContent>
            </GenericTile>
            <GenericTile id="tileAssigned" header="Assigned" subheader="In use by employees" class="kpiCard">
                <TileContent><NumericContent value="{dashboard>/assignedAssets}" withMargin="false" icon="sap-icon://employee" valueColor="Neutral" /></TileContent>
            </GenericTile>
            <GenericTile id="tileMaintenance" header="Maintenance" subheader="Currently repairing" class="kpiCard">
                <TileContent><NumericContent value="{dashboard>/maintenanceAssets}" withMargin="false" icon="sap-icon://wrench" valueColor="Critical" /></TileContent>
            </GenericTile>
            <GenericTile id="tileRetired" header="Retired" subheader="End of life" class="kpiCard">
                <TileContent><NumericContent value="{dashboard>/retiredAssets}" withMargin="false" icon="sap-icon://decline" valueColor="Error" /></TileContent>
            </GenericTile>
            <GenericTile id="tileArchived" header="Archived" subheader="Moved to history" class="kpiCard">
                <TileContent><NumericContent value="{dashboard>/archivedAssets}" withMargin="false" icon="sap-icon://folder" valueColor="Neutral" /></TileContent>
            </GenericTile>
        </HBox>
    </VBox>

    <HBox id="chartRow" justifyContent="SpaceBetween" wrap="Wrap">
        <VBox id="statusBox" width="48%">
            <Title id="statusTitle" text="Assets By Status" level="H2" class="sectionTitle" />
            <viz:VizFrame id="statusChart" vizType="donut" width="100%" height="400px">
                <viz:dataset>
                    <viz.data:FlattenedDataset id="statusDataset" data="{dashboard>/statusChart}">
                        <viz.data:dimensions><viz.data:DimensionDefinition id="statusDimension" name="Status" value="{dashboard>status}" /></viz.data:dimensions>
                        <viz.data:measures><viz.data:MeasureDefinition id="statusMeasure" name="Assets" value="{dashboard>assetCount}" /></viz.data:measures>
                    </viz.data:FlattenedDataset>
                </viz:dataset>
                <viz:feeds>
                    <viz.feeds:FeedItem id="statusSizeFeed" uid="size" type="Measure" values="Assets" />
                    <viz.feeds:FeedItem id="statusColorFeed" uid="color" type="Dimension" values="Status" />
                </viz:feeds>
            </viz:VizFrame>
        </VBox>
        <VBox id="categoryBox" width="48%">
            <Title id="categoryTitle" text="Assets By Category" level="H2" class="sectionTitle" />
            <viz:VizFrame id="categoryChart" vizType="column" width="100%" height="400px">
                <viz:dataset>
                    <viz.data:FlattenedDataset id="categoryDataset" data="{dashboard>/categoryChart}">
                        <viz.data:dimensions><viz.data:DimensionDefinition id="categoryDimension" name="Category" value="{dashboard>categoryName}" /></viz.data:dimensions>
                        <viz.data:measures><viz.data:MeasureDefinition id="categoryMeasure" name="Assets" value="{dashboard>assetCount}" /></viz.data:measures>
                    </viz.data:FlattenedDataset>
                </viz:dataset>
                <viz:feeds>
                    <viz.feeds:FeedItem id="categoryValueFeed" uid="valueAxis" type="Measure" values="Assets" />
                    <viz.feeds:FeedItem id="categoryDimensionFeed" uid="categoryAxis" type="Dimension" values="Category" />
                </viz:feeds>
            </viz:VizFrame>
        </VBox>
    </HBox>

    <VBox id="departmentBox" class="sapUiMediumMarginTop">
        <Title id="departmentTitle" text="Assets By Department" level="H2" class="sectionTitle" />
        <viz:VizFrame id="departmentChart" vizType="bar" width="100%" height="400px">
            <viz:dataset>
                <viz.data:FlattenedDataset id="departmentDataset" data="{dashboard>/departmentChart}">
                    <viz.data:dimensions><viz.data:DimensionDefinition id="departmentDimension" name="Department" value="{dashboard>departmentName}" /></viz.data:dimensions>
                    <viz.data:measures><viz.data:MeasureDefinition id="departmentMeasure" name="Assets" value="{dashboard>assetCount}" /></viz.data:measures>
                </viz.data:FlattenedDataset>
            </viz:dataset>
            <viz:feeds>
                <viz.feeds:FeedItem id="departmentValueFeed" uid="valueAxis" type="Measure" values="Assets" />
                <viz.feeds:FeedItem id="departmentCategoryFeed" uid="categoryAxis" type="Dimension" values="Department" />
            </viz:feeds>
        </viz:VizFrame>
    </VBox>
</VBox>

                    <!-- ASSETS -->
                    <VBox id="assetsContainer" visible="false" class="dashboard-wrapper">
                        <Title id="assetsTitle" text="Asset Management" level="H2" class="sectionTitle" />
                        <Text text="Create, assign, and track organizational assets" class="sectionSubtitle" />
                        <OverflowToolbar class="actionBar">
                            <Button id="createAssetBtn" text="Create Asset" icon="sap-icon://add" class="btn btn--primary" press=".onCreateAsset" />
                            <Button id="assignAssetBtn" text="Assign Asset" icon="sap-icon://employee" class="btn btn--ghost" press=".onAssignAsset" />
                            <Button id="returnAssetBtn" text="Return Asset" icon="sap-icon://undo" class="btn btn--ghost" press=".onReturnAsset" />
                            <Button id="transferAssetBtn" text="Transfer Asset" icon="sap-icon://shuffle" class="btn btn--ghost" press=".onTransferAsset" />
                            
                            <!-- THE MAINTENANCE BUTTONS -->
                            <Button id="maintenanceAssetBtn" text="Send for Maintenance" icon="sap-icon://wrench" class="btn btn--ghost" press=".onSendForMaintenance" />
                            <Button id="returnMaintenanceBtn" text="Return from Maint." icon="sap-icon://accept" class="btn btn--ghost" press=".onReturnFromMaintenance" />
                            
                            <Button id="retireAssetBtn" text="Retire Asset" icon="sap-icon://delete" class="btn btn--danger" press=".onRetireAsset" />
                            <ToolbarSpacer />
                            <SearchField id="assetSearch" width="250px" liveChange=".onAssetSearch" placeholder="Search Asset" class="searchField" />
                        </OverflowToolbar>
                        <Table id="assetTable" mode="SingleSelectMaster" includeItemInSelection="true" items="{assets>/}" class="enhancedTable">
                            <columns>
                                <Column><Text text="Asset Tag" class="tableColumnHeader" /></Column>
                                <Column><Text text="Model" class="tableColumnHeader" /></Column>
                                <Column><Text text="Category" class="tableColumnHeader" /></Column>
                                <Column><Text text="Status" class="tableColumnHeader" /></Column>
                                <Column><Text text="Current Holder" class="tableColumnHeader" /></Column>
                                <Column><Text text="Purchase Date" class="tableColumnHeader" /></Column>
                            </columns>
                            <items>
                                <ColumnListItem type="Active">
                                    <cells>
                                        <Text text="{assets>assetTag}" class="tableCellBold" />
                                        <Text text="{assets>model}" class="tableCell" />
                                        <Text text="{assets>categoryName}" class="tableCell" />
                                        <ObjectStatus text="{assets>status}" state="{= ${assets>status} === 'ASSIGNED' ? 'Success' : ${assets>status} === 'MAINTENANCE' ? 'Warning' : ${assets>status} === 'AVAILABLE' ? 'Information' : 'Error' }" class="statusBadge" />
                                        <Text text="{assets>currentHolderName}" class="tableCell" />
                                        <Text text="{assets>purchaseDate}" class="tableCell" />
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </VBox>

                    <!-- REQUESTS -->
                    <VBox id="requestsContainer" visible="false" class="dashboard-wrapper">
                        <Title text="Asset Request Management" level="H2" class="sectionTitle" />
                        <Text text="Review, approve, or reject employee asset requests" class="sectionSubtitle" />
                        <OverflowToolbar class="actionBar">
                            <Button text="Approve" icon="sap-icon://accept" class="btn btn--primary" press=".onApproveRequest" />
                            <Button text="Reject" icon="sap-icon://decline" class="btn btn--danger" press=".onRejectRequest" />
                            <Button text="Refresh" icon="sap-icon://refresh" class="btn btn--ghost" press=".onRefreshRequests" />
                            <ToolbarSpacer />
                            <SearchField width="250px" liveChange=".onRequestSearch" placeholder="Search Request" class="searchField" />
                        </OverflowToolbar>
                        <Table id="requestTable" mode="SingleSelectMaster" includeItemInSelection="true" items="{requests>/}" class="enhancedTable">
                            <columns>
                                <Column><Text text="Employee" class="tableColumnHeader" /></Column>
                                <Column><Text text="Category" class="tableColumnHeader" /></Column>
                                <Column><Text text="Justification" class="tableColumnHeader" /></Column>
                                <Column><Text text="Status" class="tableColumnHeader" /></Column>
                                <Column><Text text="Approval Date" class="tableColumnHeader" /></Column>
                            </columns>
                            <items>
                                <ColumnListItem type="Active">
                                    <cells>
                                        <Text text="{requests>employeeName}" class="tableCellBold" />
                                        <Text text="{requests>categoryName}" class="tableCell" />
                                        <Text text="{requests>justification}" class="tableCell" />
                                        <ObjectStatus text="{requests>status}" state="{= ${requests>status} === 'APPROVED' ? 'Success' : ${requests>status} === 'REJECTED' ? 'Error' : 'Warning' }" class="statusBadge" />
                                        <Text text="{requests>approvalDate}" class="tableCell" />
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </VBox>

                    <!-- EMPLOYEES -->
                    <VBox id="employeesContainer" visible="false" class="dashboard-wrapper">
                        <Title id="employeesTitle" text="Employee Administration" level="H2" class="sectionTitle" />
                        <Text text="Manage employee records and system access" class="sectionSubtitle" />
                        <OverflowToolbar class="actionBar">
                            <Button id="createEmployeeBtn" text="Create Employee" icon="sap-icon://add" class="btn btn--primary" press=".onCreateEmployee" />
                            <Button text="Edit Selected" icon="sap-icon://edit" class="btn btn--ghost" press=".onEditEmployee" />
                            <Button text="Delete Selected" icon="sap-icon://delete" class="btn btn--danger" press=".onDeleteEmployee" />
                            <ToolbarSpacer />
                            <SearchField id="employeeSearch" width="250px" liveChange=".onEmployeeSearch" placeholder="Search Employee" class="searchField" />
                        </OverflowToolbar>
                        <Table id="employeeTable" mode="SingleSelectMaster" includeItemInSelection="true" items="{employees>/}" class="enhancedTable">
                            <columns>
                                <Column><Text text="Employee Number" class="tableColumnHeader" /></Column>
                                <Column><Text text="Full Name" class="tableColumnHeader" /></Column>
                                <Column><Text text="Email" class="tableColumnHeader" /></Column>
                                <Column><Text text="Role" class="tableColumnHeader" /></Column>
                                <Column><Text text="Status" class="tableColumnHeader" /></Column>
                            </columns>
                            <items>
                                <ColumnListItem type="Active">
                                    <cells>
                                        <Text text="{employees>employeeNumber}" class="tableCellBold" />
                                        <Text text="{employees>fullName}" class="tableCell" />
                                        <Text text="{employees>email}" class="tableCell" />
                                        <Text text="{employees>role}" class="tableCell" />
                                        <Text text="{employees>status}" class="tableCell" />
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </VBox>

                    <!-- DEPARTMENTS -->
                    <VBox id="departmentsContainer" visible="false" class="dashboard-wrapper">
                        <Title id="departmentsTitle" text="Department Management" level="H2" class="sectionTitle" />
                        <Text text="Manage organizational departments and cost centers" class="sectionSubtitle" />
                        <OverflowToolbar class="actionBar">
                            <Button id="createDepartmentBtn" text="Create Department" icon="sap-icon://add" class="btn btn--primary" press=".onCreateDepartment" />
                            <Button id="editDepartmentBtn" text="Edit Selected" icon="sap-icon://edit" class="btn btn--ghost" press=".onEditDepartment" />
                            <Button id="deleteDepartmentBtn" text="Delete Selected" icon="sap-icon://delete" class="btn btn--danger" press=".onDeleteDepartment" />
                            <ToolbarSpacer />
                            <SearchField id="departmentSearch" width="250px" liveChange=".onDepartmentSearch" placeholder="Search Department" class="searchField" />
                        </OverflowToolbar>
                        <Table id="departmentTable" mode="SingleSelectMaster" includeItemInSelection="true" items="{departments>/}" class="enhancedTable">
                            <columns>
                                <Column><Text text="Department" class="tableColumnHeader" /></Column>
                                <Column><Text text="Cost Center" class="tableColumnHeader" /></Column>
                                <Column><Text text="Active" class="tableColumnHeader" /></Column>
                            </columns>
                            <items>
                                <ColumnListItem type="Active">
                                    <cells>
                                        <Text text="{departments>departmentName}" class="tableCellBold" />
                                        <Text text="{departments>costCenter}" class="tableCell" />
                                        <Text text="{departments>isActive}" class="tableCell" />
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </VBox>

                    <!-- VENDORS -->
                    <VBox id="vendorsContainer" visible="false" class="dashboard-wrapper">
                        <Title id="vendorsTitle" text="Vendor Management" level="H2" class="sectionTitle" />
                        <Text text="Maintain vendor directory and contact information" class="sectionSubtitle" />
                        <OverflowToolbar class="actionBar">
                            <Button id="createVendorBtn" text="Create Vendor" icon="sap-icon://add" class="btn btn--primary" press=".onCreateVendor" />
                            <Button id="editVendorBtn" text="Edit Selected" icon="sap-icon://edit" class="btn btn--ghost" press=".onEditVendor" />
                            <Button id="deleteVendorBtn" text="Delete Selected" icon="sap-icon://delete" class="btn btn--danger" press=".onDeleteVendor" />
                            <ToolbarSpacer />
                            <SearchField id="vendorSearch" width="250px" liveChange=".onVendorSearch" placeholder="Search Vendor" class="searchField" />
                        </OverflowToolbar>
                        <Table id="vendorTable" mode="SingleSelectMaster" includeItemInSelection="true" items="{vendors>/}" class="enhancedTable">
                            <columns>
                                <Column><Text text="Vendor Name" class="tableColumnHeader" /></Column>
                                <Column><Text text="Email" class="tableColumnHeader" /></Column>
                                <Column><Text text="Phone" class="tableColumnHeader" /></Column>
                            </columns>
                            <items>
                                <ColumnListItem type="Active">
                                    <cells>
                                        <Text text="{vendors>vendorName}" class="tableCellBold" />
                                        <Text text="{vendors>email}" class="tableCell" />
                                        <Text text="{vendors>phone}" class="tableCell" />
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </VBox>

                    <!-- CATEGORIES -->
                    <VBox id="categoriesContainer" visible="false" class="dashboard-wrapper">
                        <Title id="categoriesTitle" text="Category Management" level="H2" class="sectionTitle" />
                        <Text text="Define asset categories and their expected lifespan" class="sectionSubtitle" />
                        <OverflowToolbar class="actionBar">
                            <Button id="createCategoryBtn" text="Create Category" icon="sap-icon://add" class="btn btn--primary" press=".onCreateCategory" />
                            <Button id="editCategoryBtn" text="Edit Selected" icon="sap-icon://edit" class="btn btn--ghost" press=".onEditCategory" />
                            <Button id="deleteCategoryBtn" text="Delete Selected" icon="sap-icon://delete" class="btn btn--danger" press=".onDeleteCategory" />
                            <ToolbarSpacer />
                            <SearchField id="categorySearch" width="250px" liveChange=".onCategorySearch" placeholder="Search Category" class="searchField" />
                        </OverflowToolbar>
                        <Table id="categoryTable" mode="SingleSelectMaster" includeItemInSelection="true" items="{categories>/}" class="enhancedTable">
                            <columns>
                                <Column><Text text="Category Name" class="tableColumnHeader" /></Column>
                                <Column><Text text="Lifespan (Months)" class="tableColumnHeader" /></Column>
                                <Column><Text text="Active" class="tableColumnHeader" /></Column>
                            </columns>
                            <items>
                                <ColumnListItem type="Active">
                                    <cells>
                                        <Text text="{categories>categoryName}" class="tableCellBold" />
                                        <Text text="{categories>lifespanMonths}" class="tableCell" />
                                        <Text text="{categories>active}" class="tableCell" />
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </VBox>

                    <!-- REPORTS -->
                    <VBox id="reportsContainer" visible="false" class="dashboard-wrapper">
                        <Title id="reportsTitle" text="Reports &amp; Analytics" level="H2" class="sectionTitle" />
                        <Text text="Generate and export system-wide data reports" class="sectionSubtitle" />
                        <OverflowToolbar class="actionBar">
                            <Button id="assetReportBtn" text="Asset Inventory" icon="sap-icon://excel-attachment" class="btn btn--primary" press=".onAssetReport" />
                            <Button id="requestReportBtn" text="Asset Requests" icon="sap-icon://document" class="btn btn--ghost" press=".onRequestReport" />
                            <Button id="employeeAssetReportBtn" text="Employee Assets" icon="sap-icon://employee" class="btn btn--ghost" press=".onEmployeeAssetReport" />
                            <ToolbarSpacer />
                            <Button id="downloadPdfBtn" text="Export PDF" icon="sap-icon://pdf-attachment" class="btn btn--primary" press=".onDownloadPdf" />
                            <Button id="sharePdfBtn" text="Share Report" icon="sap-icon://share" class="btn btn--ghost" press=".onSharePdf" />
                        </OverflowToolbar>
                        <Table id="assetReportTable" visible="true" growing="true" sticky="ColumnHeaders" items="{assetReports>/}" class="enhancedTable">
                            <columns>
                                <Column><Text text="Asset Tag" class="tableColumnHeader" /></Column>
                                <Column><Text text="Model" class="tableColumnHeader" /></Column>
                                <Column><Text text="Status" class="tableColumnHeader" /></Column>
                                <Column><Text text="Current Holder" class="tableColumnHeader" /></Column>
                            </columns>
                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <Text text="{assetReports>assetTag}" class="tableCellBold" />
                                        <Text text="{assetReports>model}" class="tableCell" />
                                        <ObjectStatus text="{assetReports>status}" class="statusBadge" />
                                        <Text text="{assetReports>currentHolderName}" class="tableCell" />
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                        <Table id="requestReportTable" visible="false" growing="true" sticky="ColumnHeaders" items="{requestReports>/}" class="enhancedTable">
                            <columns>
                                <Column><Text text="Employee" class="tableColumnHeader" /></Column>
                                <Column><Text text="Category" class="tableColumnHeader" /></Column>
                                <Column><Text text="Status" class="tableColumnHeader" /></Column>
                                <Column><Text text="Approval Date" class="tableColumnHeader" /></Column>
                                <Column><Text text="Remarks" class="tableColumnHeader" /></Column>
                            </columns>
                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <Text text="{requestReports>employeeName}" class="tableCell" />
                                        <Text text="{requestReports>categoryName}" class="tableCell" />
                                        <ObjectStatus text="{requestReports>status}" class="statusBadge" />
                                        <Text text="{requestReports>approvalDate}" class="tableCell" />
                                        <Text text="{requestReports>remarks}" class="tableCell" />
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                        <Table id="employeeReportTable" visible="false" growing="true" sticky="ColumnHeaders" items="{employeeReports>/}" class="enhancedTable">
                            <columns>
                                <Column><Text text="Employee Number" class="tableColumnHeader" /></Column>
                                <Column><Text text="Employee Name" class="tableColumnHeader" /></Column>
                                <Column><Text text="Role" class="tableColumnHeader" /></Column>
                                <Column><Text text="Status" class="tableColumnHeader" /></Column>
                            </columns>
                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <Text text="{employeeReports>employeeNumber}" class="tableCellBold" />
                                        <Text text="{employeeReports>fullName}" class="tableCell" />
                                        <Text text="{employeeReports>role}" class="tableCell" />
                                        <Text text="{employeeReports>status}" class="tableCell" />
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </VBox>

                </VBox>
            </HBox>
        </content>
    </Page>
</mvc:View>