<mvc:View
    controllerName="asset.lifecycle.portal.adminportal.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.data="sap.viz.ui5.data"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds">

<Page
    id="portalPage"
    title="Enterprise Asset Lifecycle Management">

        <content>

            <HBox
                id="mainLayout"
                width="100%">

                <!-- LEFT NAVIGATION -->

 <List
    id="navigationMenu"
    width="450px"
    mode="SingleSelectMaster"
    selectionChange=".onMenuSelect">

    <StandardListItem
        id="assetsItem"
        title="Assets"
        icon="sap-icon://laptop"
        type="Active" />

    <StandardListItem
        id="requestsItem"
        title="Asset Requests"
        icon="sap-icon://workflow-tasks"
        type="Active" />

    <StandardListItem
        id="employeesItem"
        title="Employees"
        icon="sap-icon://employee"
        type="Active" />

    <StandardListItem
        id="departmentsItem"
        title="Departments"
        icon="sap-icon://building"
        type="Active" />

    <StandardListItem
        id="vendorsItem"
        title="Vendors"
        icon="sap-icon://supplier"
        type="Active" />

    <StandardListItem
        id="categoriesItem"
        title="Categories"
        icon="sap-icon://tag"
        type="Active" />

    <StandardListItem
    id="reportsItem"
    title="Reports"
    icon="sap-icon://business-objects-experience"
    type="Active" />

    <StandardListItem
    id="dashboardItem"
    title="Dashboard"
    icon="sap-icon://business-objects-experience"
    type="Active" />

</List>

                <!-- RIGHT CONTENT -->

                <VBox
                    id="contentArea"
                    width="100%"
                    class="sapUiResponsiveContentPadding">

                   <Title
                        id="contentTitle"
                        text="Dashboard"
                        level="H1"
                        titleStyle="H1"
                        class="sapUiLargeMarginBottom sapUiSmallMarginTop" />

                    <Text
                        id="contentText"
                        text="Enterprise Asset Management Dashboard" />

                    <Panel
                        id="contentPanel"
                        headerText="Dashboard"
                        width="100%">

                        <!-- DASHBOARD -->

                        <VBox
                            id="dashboardContainer"
                            visible="true"
                            class="sapUiMediumMargin">

                            <!-- HEADER -->

                            <VBox
                                id="headerBox"
                                class="dashboardHeader">

                                <Title
                                    id="dashboardTitle"
                                    text="Enterprise Asset Management Dashboard"
                                    level="H1"/>

                                <Text
                                    id="dashboardSubTitle"
                                    text="Real-Time Asset Lifecycle Monitoring"/>

                            </VBox>

                            <!-- KPI SECTION -->

                            <VBox
                                id="dashboardVBox"
                                class="sapUiMediumMargin">

                                <Title
                                    id="overviewTitle"
                                    text="Asset Overview"
                                    level="H2"/>

                                <HBox
                                    id="kpiHBox"
                                    justifyContent="Center"
                                    wrap="Wrap">

                                    <GenericTile
                                        id="tileTotal"
                                        header="Total Assets">
                                        <TileContent>
                                            <NumericContent value="{dashboard>/totalAssets}" />
                                        </TileContent>
                                    </GenericTile>

                                    <GenericTile
                                        id="tileAvailable"
                                        header="Available Assets">
                                        <TileContent>
                                            <NumericContent value="{dashboard>/availableAssets}" />
                                        </TileContent>
                                    </GenericTile>

                                    <GenericTile
                                        id="tileAssigned"
                                        header="Assigned Assets">
                                        <TileContent>
                                            <NumericContent value="{dashboard>/assignedAssets}" />
                                        </TileContent>
                                    </GenericTile>

                                    <GenericTile
                                        id="tileMaintenance"
                                        header="Maintenance Assets">
                                        <TileContent>
                                            <NumericContent value="{dashboard>/maintenanceAssets}" />
                                        </TileContent>
                                    </GenericTile>

                                    <GenericTile
                                        id="tileRetired"
                                        header="Retired Assets">
                                        <TileContent>
                                            <NumericContent value="{dashboard>/retiredAssets}" />
                                        </TileContent>
                                    </GenericTile>

                                    <GenericTile
                                        id="tileArchived"
                                        header="Archived Assets">
                                        <TileContent>
                                            <NumericContent value="{dashboard>/archivedAssets}" />
                                        </TileContent>
                                    </GenericTile>

                                </HBox>

                            </VBox>

                            <!-- CHART ROW -->

                            <HBox
                                id="chartRow"
                                justifyContent="SpaceAround"
                                wrap="Wrap">

                                <!-- STATUS CHART -->

                                <VBox
                                    id="statusBox"
                                    width="48%">

                                    <Title
                                        id="statusTitle"
                                        text="Assets By Status"
                                        level="H2" />

                                    <viz:VizFrame
                                        id="statusChart"
                                        vizType="donut"
                                        width="100%"
                                        height="400px">

                                        <viz:dataset>

                                            <viz.data:FlattenedDataset
                                                id="statusDataset"
                                                data="{dashboard>/statusChart}">

                                                <viz.data:dimensions>

                                                    <viz.data:DimensionDefinition
                                                        id="statusDimension"
                                                        name="Status"
                                                        value="{dashboard>status}" />

                                                </viz.data:dimensions>

                                                <viz.data:measures>

                                                    <viz.data:MeasureDefinition
                                                        id="statusMeasure"
                                                        name="Assets"
                                                        value="{dashboard>assetCount}" />

                                                </viz.data:measures>

                                            </viz.data:FlattenedDataset>

                                        </viz:dataset>

                                        <viz:feeds>

                                            <viz.feeds:FeedItem
                                                id="statusSizeFeed"
                                                uid="size"
                                                type="Measure"
                                                values="Assets" />

                                            <viz.feeds:FeedItem
                                                id="statusColorFeed"
                                                uid="color"
                                                type="Dimension"
                                                values="Status" />

                                        </viz:feeds>

                                    </viz:VizFrame>

                                </VBox>

                                <!-- CATEGORY CHART -->

                                <VBox
                                    id="categoryBox"
                                    width="48%">

                                    <Title
                                        id="categoryTitle"
                                        text="Assets By Category"
                                        level="H2" />

                                    <viz:VizFrame
                                        id="categoryChart"
                                        vizType="column"
                                        width="100%"
                                        height="400px">

                                        <viz:dataset>

                                            <viz.data:FlattenedDataset
                                                id="categoryDataset"
                                                data="{dashboard>/categoryChart}">

                                                <viz.data:dimensions>

                                                    <viz.data:DimensionDefinition
                                                        id="categoryDimension"
                                                        name="Category"
                                                        value="{dashboard>categoryName}" />

                                                </viz.data:dimensions>

                                                <viz.data:measures>

                                                    <viz.data:MeasureDefinition
                                                        id="categoryMeasure"
                                                        name="Assets"
                                                        value="{dashboard>assetCount}" />

                                                </viz.data:measures>

                                            </viz.data:FlattenedDataset>

                                        </viz:dataset>

                                        <viz:feeds>

                                            <viz.feeds:FeedItem
                                                id="categoryValueFeed"
                                                uid="valueAxis"
                                                type="Measure"
                                                values="Assets" />

                                            <viz.feeds:FeedItem
                                                id="categoryDimensionFeed"
                                                uid="categoryAxis"
                                                type="Dimension"
                                                values="Category" />

                                        </viz:feeds>

                                    </viz:VizFrame>

                                </VBox>

                            </HBox>

                            <!-- DEPARTMENT -->

                            <VBox
                                id="departmentBox"
                                class="sapUiMediumMarginTop">

                                <Title
                                    id="departmentTitle"
                                    text="Assets By Department"
                                    level="H2" />

                                <viz:VizFrame
                                    id="departmentChart"
                                    vizType="bar"
                                    width="100%"
                                    height="400px">

                                    <viz:dataset>

                                        <viz.data:FlattenedDataset
                                            id="departmentDataset"
                                            data="{dashboard>/departmentChart}">

                                            <viz.data:dimensions>

                                                <viz.data:DimensionDefinition
                                                    id="departmentDimension"
                                                    name="Department"
                                                    value="{dashboard>departmentName}" />

                                            </viz.data:dimensions>

                                            <viz.data:measures>

                                                <viz.data:MeasureDefinition
                                                    id="departmentMeasure"
                                                    name="Assets"
                                                    value="{dashboard>assetCount}" />

                                            </viz.data:measures>

                                        </viz.data:FlattenedDataset>

                                    </viz:dataset>

                                    <viz:feeds>

                                        <viz.feeds:FeedItem
                                            id="departmentValueFeed"
                                            uid="valueAxis"
                                            type="Measure"
                                            values="Assets" />

                                        <viz.feeds:FeedItem
                                            id="departmentCategoryFeed"
                                            uid="categoryAxis"
                                            type="Dimension"
                                            values="Department" />

                                    </viz:feeds>

                                </viz:VizFrame>

                            </VBox>

                        </VBox>

                        <!-- EMPLOYEES -->

                        <VBox
                            id="employeesContainer"
                            visible="false">

                            <Title
                                id="employeesTitle"
                                text="Employee Administration"
                                level="H2"
                                titleStyle="H2" />

<Toolbar id="employeeToolbar">

    <Button
        id="createEmployeeBtn"
        text="Create Employee"
        type="Emphasized"
        press=".onCreateEmployee" />

   <Button
    text="Edit Selected"
    type="Attention"
    icon="sap-icon://edit"
    press=".onEditEmployee" />

    <Button
    text="Delete Selected"
    type="Negative"
    icon="sap-icon://delete"
    press=".onDeleteEmployee" />

    <ToolbarSpacer
        id="employeeToolbarSpacer" />

    <SearchField
        id="employeeSearch"
width="320px"
        liveChange=".onEmployeeSearch"
        placeholder="Search Employee" />

</Toolbar>


                            <Table
                                id="employeeTable"
                                mode="SingleSelectMaster"
                                includeItemInSelection="true"
                                items="{employees>/}">


                                <columns>

                                    <Column id="empCol1">
                                        <Text
                                            id="empHdr1"
                                            text="Employee Number" />
                                    </Column>

                                    <Column id="empCol2">
                                        <Text
                                            id="empHdr2"
                                            text="Full Name" />
                                    </Column>

                                    <Column id="empCol3">
                                        <Text
                                            id="empHdr3"
                                            text="Email" />
                                    </Column>

                                    <Column id="empCol4">
                                        <Text
                                            id="empHdr4"
                                            text="Role" />
                                    </Column>

                                    <Column id="empCol5">
                                        <Text
                                            id="empHdr5"
                                            text="Status" />
                                    </Column>

                                </columns>

                                <items>

                                    <ColumnListItem id="empRowTemplate">

                                        <cells>

                                            <Text
                                                id="empCell1"
                                                text="{employees>employeeNumber}" />

                                            <Text
                                                id="empCell2"
                                                text="{employees>fullName}" />

                                            <Text
                                                id="empCell3"
                                                text="{employees>email}" />

                                            <Text
                                                id="empCell4"
                                                text="{employees>role}" />

                                            <Text
                                                id="empCell5"
                                                text="{employees>status}" />

                                        </cells>

                                    </ColumnListItem>

                                </items>

                            </Table>

                        </VBox>

                        <!-- DEPARTMENTS -->

                        <VBox
                            id="departmentsContainer"
                            visible="false">

                            <Title
                                id="departmentsTitle"
                                text="Department Management" />

                                <Toolbar id="departmentToolbar">

    <Button
        id="createDepartmentBtn"
        text="Create Department"
        type="Emphasized"
        press=".onCreateDepartment" />

    <Button
        id="editDepartmentBtn"
        text="Edit Selected"
        press=".onEditDepartment" />

    <Button
        id="deleteDepartmentBtn"
        text="Delete Selected"
        type="Negative"
        press=".onDeleteDepartment" />

    <ToolbarSpacer />

    <SearchField
        id="departmentSearch"
width="320px"
        liveChange=".onDepartmentSearch"
        placeholder="Search Department" />

</Toolbar>

                            <Table
                                id="departmentTable"
                                mode="SingleSelectMaster"
                                includeItemInSelection="true"
                                items="{departments>/}">

                                <columns>

                                    <Column id="deptCol1">
                                        <Text
                                            id="deptHdr1"
                                            text="Department" />
                                    </Column>

                                    <Column id="deptCol2">
                                        <Text
                                            id="deptHdr2"
                                            text="Cost Center" />
                                    </Column>

                                    <Column id="deptCol3">
                                        <Text
                                            id="deptHdr3"
                                            text="Active" />
                                    </Column>

                                </columns>

                                <items>

                                    <ColumnListItem id="deptRowTemplate">

                                        <cells>

                                            <Text
                                                id="deptCell1"
                                                text="{departments>departmentName}" />

                                            <Text
                                                id="deptCell2"
                                                text="{departments>costCenter}" />

                                            <Text
                                                id="deptCell3"
                                                text="{departments>isActive}" />

                                        </cells>

                                    </ColumnListItem>

                                </items>

                            </Table>

                        </VBox>

                        <!-- VENDORS -->

                        <VBox
                            id="vendorsContainer"
                            visible="false">

                            <Title
                                id="vendorsTitle"
                                text="Vendor Management" />

                                <Toolbar id="vendorToolbar">

    <Button
        id="createVendorBtn"
        text="Create Vendor"
        type="Emphasized"
        press=".onCreateVendor" />

    <Button
        id="editVendorBtn"
        text="Edit Selected"
        press=".onEditVendor" />

    <Button
        id="deleteVendorBtn"
        text="Delete Selected"
        type="Negative"
        press=".onDeleteVendor" />

    <ToolbarSpacer />

    <SearchField
        id="vendorSearch"
width="320px"
        liveChange=".onVendorSearch"
        placeholder="Search Vendor" />

</Toolbar>

                            <Table
                                id="vendorTable"
                                mode="SingleSelectMaster"
                                includeItemInSelection="true"
                                items="{vendors>/}">


                                <columns>

                                    <Column id="vendorCol1">
                                        <Text
                                            id="vendorHdr1"
                                            text="Vendor Name" />
                                    </Column>

                                    <Column id="vendorCol2">
                                        <Text
                                            id="vendorHdr2"
                                            text="Email" />
                                    </Column>

                                    <Column id="vendorCol3">
                                        <Text
                                            id="vendorHdr3"
                                            text="Phone" />
                                    </Column>

                                </columns>

                                <items>

                                    <ColumnListItem id="vendorRowTemplate">

                                        <cells>

                                            <Text
                                                id="vendorCell1"
                                                text="{vendors>vendorName}" />

                                            <Text
                                                id="vendorCell2"
                                                text="{vendors>email}" />

                                            <Text
                                                id="vendorCell3"
                                                text="{vendors>phone}" />

                                        </cells>

                                    </ColumnListItem>

                                </items>

                            </Table>

                        </VBox>

                        <!-- CATEGORIES -->

                        <VBox
                            id="categoriesContainer"
                            visible="false">

                            <Title
                                id="categoriesTitle"
                                text="Category Management" />

                            <Toolbar id="categoryToolbar">

    <Button
        id="createCategoryBtn"
        text="Create Category"
        type="Emphasized"
        press=".onCreateCategory" />

    <Button
        id="editCategoryBtn"
        text="Edit Selected"
        press=".onEditCategory" />

    <Button
        id="deleteCategoryBtn"
        text="Delete Selected"
        type="Negative"
        press=".onDeleteCategory" />

    <ToolbarSpacer />

    <SearchField
        id="categorySearch"
width="320px"
        liveChange=".onCategorySearch"
        placeholder="Search Category" />

</Toolbar>


                            <Table
                                id="categoryTable"
                                mode="SingleSelectMaster"
                                includeItemInSelection="true"
                                items="{categories>/}">

                                <columns>

                                    <Column id="categoryCol1">
                                        <Text
                                            id="categoryHdr1"
                                            text="Category Name" />
                                    </Column>

                                    <Column id="categoryCol2">
                                        <Text
                                            id="categoryHdr2"
                                            text="Lifespan" />
                                    </Column>

                                    <Column id="categoryCol3">
                                        <Text
                                            id="categoryHdr3"
                                            text="Active" />
                                    </Column>

                                </columns>

                                <items>

                                    <ColumnListItem id="categoryRowTemplate">

                                        <cells>

                                            <Text
                                                id="categoryCell1"
                                                text="{categories>categoryName}" />

                                            <Text
                                                id="categoryCell2"
                                                text="{categories>lifespanMonths}" />

                                            <Text
                                                id="categoryCell3"
                                                text="{categories>active}" />

                                        </cells>

                                    </ColumnListItem>

                                </items>

                            </Table>

                        </VBox>

                        <!-- REPORTS -->

<VBox
    id="reportsContainer"
    visible="false">

    <Title
        id="reportsTitle"
        text="Reports" />

    <Toolbar
        id="reportsToolbar">

        <Button
            id="assetReportBtn"
            text="Asset Inventory Report"
            icon="sap-icon://excel-attachment"
            type="Emphasized"
            press=".onAssetReport" />

        <Button
            id="requestReportBtn"
            text="Asset Request Report"
            icon="sap-icon://document"
            press=".onRequestReport" />

        <Button
            id="employeeAssetReportBtn"
            text="Employee Asset Report"
            icon="sap-icon://employee"
            press=".onEmployeeAssetReport" />

        <Button
            id="downloadPdfBtn"
            text="Download PDF"
            icon="sap-icon://pdf-attachment"
            type="Emphasized"
            press=".onDownloadPdf" />

        <Button
            id="sharePdfBtn"
            text="Share PDF"
            icon="sap-icon://share"
            press=".onSharePdf" />

    </Toolbar>

    <!-- ASSET REPORT -->

    <Table
        id="assetReportTable"
        visible="true"
        growing="true"
        sticky="ColumnHeaders"
        items="{assetReports>/}">

        <columns>

            <Column id="assetReportCol1">
                <Text id="assetReportHdr1" text="Asset Tag" />
            </Column>

            <Column id="assetReportCol2">
                <Text id="assetReportHdr2" text="Model" />
            </Column>

            <Column id="assetReportCol3">
                <Text id="assetReportHdr3" text="Status" />
            </Column>

            <Column id="assetReportCol4">
                <Text id="assetReportHdr4" text="Current Holder" />
            </Column>

        </columns>

        <items>

            <ColumnListItem id="assetReportRow">

                <cells>

                    <Text
                        id="assetReportCell1"
                        text="{assetReports>assetTag}" />

                    <Text
                        id="assetReportCell2"
                        text="{assetReports>model}" />

                    <Text
                        id="assetReportCell3"
                        text="{assetReports>status}" />

                    <Text
                        id="assetReportCell4"
                        text="{assetReports>currentHolderName}" />

                </cells>

            </ColumnListItem>

        </items>

    </Table>

    <!-- REQUEST REPORT -->

    <Table
        id="requestReportTable"
        visible="false"
        growing="true"
        sticky="ColumnHeaders"
        items="{requestReports>/}">

        <columns>

            <Column id="requestReportCol1">
                <Text id="requestReportHdr1" text="Employee" />
            </Column>

            <Column id="requestReportCol2">
                <Text id="requestReportHdr2" text="Category" />
            </Column>

            <Column id="requestReportCol3">
                <Text id="requestReportHdr3" text="Status" />
            </Column>

            <Column id="requestReportCol4">
                <Text id="requestReportHdr4" text="Approval Date" />
            </Column>

            <Column id="requestReportCol5">
                <Text id="requestReportHdr5" text="Remarks" />
            </Column>

        </columns>

        <items>

            <ColumnListItem id="requestReportRow">

                <cells>

                    <Text
                        id="requestReportCell1"
                        text="{requestReports>employeeName}" />

                    <Text
                        id="requestReportCell2"
                        text="{requestReports>categoryName}" />

                    <Text
                        id="requestReportCell3"
                        text="{requestReports>status}" />

                    <Text
                        id="requestReportCell4"
                        text="{requestReports>approvalDate}" />

                    <Text
                        id="requestReportCell5"
                        text="{requestReports>remarks}" />

                </cells>

            </ColumnListItem>

        </items>

    </Table>

    <!-- EMPLOYEE REPORT -->

    <Table
        id="employeeReportTable"
        visible="false"
        growing="true"
        sticky="ColumnHeaders"
        items="{employeeReports>/}">

        <columns>

            <Column id="employeeReportCol1">
                <Text id="employeeReportHdr1" text="Employee Number" />
            </Column>

            <Column id="employeeReportCol2">
                <Text id="employeeReportHdr2" text="Employee Name" />
            </Column>

            <Column id="employeeReportCol3">
                <Text id="employeeReportHdr3" text="Role" />
            </Column>

            <Column id="employeeReportCol4">
                <Text id="employeeReportHdr4" text="Status" />
            </Column>

        </columns>

        <items>

            <ColumnListItem id="employeeReportRow">

                <cells>

                    <Text
                        id="employeeReportCell1"
                        text="{employeeReports>employeeNumber}" />

                    <Text
                        id="employeeReportCell2"
                        text="{employeeReports>fullName}" />

                    <Text
                        id="employeeReportCell3"
                        text="{employeeReports>role}" />

                    <Text
                        id="employeeReportCell4"
                        text="{employeeReports>status}" />

                </cells>

            </ColumnListItem>

        </items>

    </Table>

</VBox>


                        <!-- REQUESTS -->

<VBox
    id="requestsContainer"
    visible="false">

    <Title
        text="Asset Request Management" />

    <Toolbar>

        <Button
            text="Approve"
            type="Accept"
            press=".onApproveRequest" />

        <Button
            text="Reject"
            type="Negative"
            press=".onRejectRequest" />

        <Button
            text="Refresh"
            press=".onRefreshRequests" />

        <ToolbarSpacer />

        <SearchField
    width="320px"
                liveChange=".onRequestSearch"
            placeholder="Search Request" />

    </Toolbar>

    <Table
        id="requestTable"
        mode="SingleSelectMaster"
        includeItemInSelection="true"
        items="{requests>/}">

        <columns>

            <Column>
                <Text text="Employee" />
            </Column>

            <Column>
                <Text text="Category" />
            </Column>

            <Column>
                <Text text="Justification" />
            </Column>

            <Column>
                <Text text="Status" />
            </Column>

            <Column>
                <Text text="Approval Date" />
            </Column>

        </columns>

        <items>

            <ColumnListItem>

                <cells>

                    <Text text="{requests>employeeName}" />

                    <Text text="{requests>categoryName}" />

                    <Text text="{requests>justification}" />

                    <ObjectStatus
                        text="{requests>status}" />

                    <Text text="{requests>approvalDate}" />

                </cells>

            </ColumnListItem>

        </items>

    </Table>

</VBox>

                        <!-- ASSETS -->

                        <VBox
                            id="assetsContainer"
                            visible="false">

                            <Title
                                id="assetsTitle"
                                text="Asset Management"
                                level="H2" />

                            <Toolbar id="assetToolbar">

                                <Button
                                    id="createAssetBtn"
                                    text="Create Asset"
                                    type="Emphasized"
                                    press=".onCreateAsset" />

                                <Button
                                    id="assignAssetBtn"
                                    text="Assign Asset"
                                    type="Emphasized"
                                    press=".onAssignAsset" />

                                <Button
                                    id="returnAssetBtn"
                                    text="Return Asset"
                                    type="Attention"
                                    press=".onReturnAsset" />

                                <Button
                                    id="transferAssetBtn"
                                    text="Transfer Asset"
                                    type="Attention"
                                    press=".onTransferAsset" />

                                <Button
                                    id="maintenanceAssetBtn"
                                    text="Send for Maintenance"
                                    type="Attention"
                                    press=".onSendForMaintenance" />

                                <Button
                                    id="retireAssetBtn"
                                    text="Retire Asset"
                                    type="Negative"
                                    press=".onRetireAsset" />

                                <ToolbarSpacer />

                                <SearchField
                                    id="assetSearch"
                                    width="320px"
                                    liveChange=".onAssetSearch"
                                    placeholder="Search Asset" />

                            </Toolbar>

                            <Table
                                id="assetTable"
                                mode="SingleSelectMaster"
                                includeItemInSelection="true"
                                items="{assets>/}">

                                <columns>

                                    <Column id="assetCol1">
                                        <Text id="assetHdr1" text="Asset Tag" />
                                    </Column>

                                    <Column id="assetCol2">
                                        <Text id="assetHdr2" text="Model" />
                                    </Column>

                                    <Column id="assetCol3">
                                        <Text id="assetHdr3" text="Category" />
                                    </Column>

                                    <Column id="assetCol4">
