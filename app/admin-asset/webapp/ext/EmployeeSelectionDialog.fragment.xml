<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core">
    
    <Dialog
        id="employeeSelectionDialog"
        title="Assign Asset"
        type="Message"
        class="sapUiResponsiveMargin"
        contentWidth="500px"
        showHeader="true">
        
        <content>
            <f:SimpleForm 
                editable="true" 
                layout="ResponsiveGridLayout"
                class="sapUiSmallMargin">
                
                <f:content>
                    
                    <!-- Employee Selection -->
                    <Label 
                        text="Select Employee"
                        required="true"
                        design="Bold"/>
                    
                    <ComboBox
                        id="employeeCombo"
                        items="{employees>/}"
                        placeholder="Type employee name or number..."
                        forceSelection="true"
                        width="100%"
                        class="sapUiSmallMarginBottom"
                        selectedKey=""
                        filterSecondaryValues="true">
                        <core:Item 
                            key="{employees>ID}"
                            text="{employees>employeeNumber} - {employees>fullName}"/>
                    </ComboBox>
                    
                    <!-- Date Selection -->
                    <Label 
                        text="Select Date"
                        required="true"
                        design="Bold"/>
                    
                    <DatePicker
                        id="assignDatePicker"
                        valueFormat="yyyy-MM-dd"
                        displayFormat="MMM DD, YYYY"
                        placeholder="Select date..."
                        width="100%"
                        class="sapUiSmallMarginBottom"
                        value=""/>
                    
                </f:content>
                
            </f:SimpleForm>
        </content>
        
        <beginButton>
            <Button 
                id="submitButton"
                text="Confirm"
                type="Emphasized"
                press=".onEmployeeDialogSubmit"/>
        </beginButton>
        
        <endButton>
            <Button 
                id="cancelButton"
                text="Cancel"
                type="Transparent"
                press=".onEmployeeDialogCancel"/>
        </endButton>
        
    </Dialog>

</core:FragmentDefinition>
