<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core">
    
    <Dialog
        id="assignAssetDialog"
        title="Assign Asset"
        type="Message"
        class="sapUiResponsiveMargin"
        contentWidth="500px"
        showHeader="true">
        
        <content>
            <f:SimpleForm 
                editable="true" 
                layout="ResponsiveGridLayout"
                class="sapUiSmallMargin">
                <f:content>
                    
                    <Label 
                        text="Employee"
                        required="true"/>
                    <ComboBox
                        id="employeeCombo"
                        items="{employees>/}"
                        placeholder="Select employee..."
                        forceSelection="true"
                        width="100%"
                        class="sapUiSmallMarginBottom">
                        <core:Item 
                            key="{employees>ID}"
                            text="{employees>employeeNumber} - {employees>fullName}"/>
                    </ComboBox>
                    
                    <Label 
                        text="Date"
                        required="true"/>
                    <DatePicker
                        id="datePicker"
                        valueFormat="yyyy-MM-dd"
                        displayFormat="MMM DD, YYYY"
                        placeholder="Select date..."
                        width="100%"
                        class="sapUiSmallMarginBottom"/>
                    
                </f:content>
            </f:SimpleForm>
        </content>
        
        <beginButton>
            <Button 
                text="Submit"
                type="Emphasized"
                press=".onDialogSubmit"/>
        </beginButton>
        
        <endButton>
            <Button 
                text="Cancel"
                type="Default"
                press=".onDialogCancel"/>
        </endButton>
        
    </Dialog>

</core:FragmentDefinition>
