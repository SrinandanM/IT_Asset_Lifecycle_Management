<mvc:View
    controllerName="asset.lifecycle.portal.managerportal.managerportal.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.data="sap.viz.ui5.data"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds">

    <Page
        id="managerPage"
        title="Manager Portal"
        class="sapUiNoContentPadding">

        <content>

            <HBox
                id="mainLayout"
                width="100%"
                height="100%"
                renderType="Bare">

                <!-- NAVIGATION SIDEBAR -->
               <VBox
    id="sidebarContainer"
    class="sidebarContainer">

    <VBox class="sidebarBranding">

        <Title
            text="EALM"
            class="sidebarLogo"/>

        <Text
            text="Manager Portal"
            class="sidebarSubtitle"/>

    </VBox>

    <List
        id="navigationMenu"
        mode="SingleSelectMaster"
        selectionChange=".onMenuSelect"
        class="sidebarNav">


                    <StandardListItem
                        title="Employees"
                        icon="sap-icon://employee" />

                    <StandardListItem
                        title="Asset Requests"
                        icon="sap-icon://workflow-tasks" />

                    <StandardListItem
                        title="Assets"
                        icon="sap-icon://laptop" />

                    <StandardListItem
                        title="Asset Allocation"
                        icon="sap-icon://employee" />

                </List>
                </VBox>

                <!-- MAIN CONTENT AREA -->
                <VBox
                    width="100%"
                    height="100%"
                    class="contentArea"
                    renderType="Bare">
 

                    <Panel
                        width="100%"
                        class="contentPanel"
                        backgroundDesign="Solid">

                        <!-- ========================================== -->
                        <!-- DASHBOARD CONTAINER                        -->
                        <!-- ========================================== -->
                        <VBox
                            id="dashboardContainer"
                            visible="true"
                            class="dashboardWrapper">

                            <!-- HEADER BOX (Gradient) -->
                            <VBox
                                id="headerBox"
                                class="dashboardHeader">
                                <Title
                                    id="dashboardTitle"
                                    text="Manager Operations Dashboard"
                                    level="H1"
                                    class="headerTitle" />
                                <Text
                                    id="dashboardSubTitle"
                                    text="Real-Time Employee Management, Asset Requests and Asset Visibility"
                                    class="headerSubTitle" />
                            </VBox>

                            <!-- KPI SECTION -->
                            <!-- KPI SECTION -->
                            <VBox
                                id="dashboardVBox"
                                class="kpiSection">
                                <Title
                                    id="overviewTitle"
                                    text="Manager Overview"
                                    level="H2"
                                    class="sectionTitle" />
                                    
                                <HBox
                                    id="kpiHBox"
                                    class="kpiContainer"
                                    wrap="Wrap"
                                    justifyContent="Start">

                                    <!-- 1. Total Employees -->
                                    <VBox class="customKpiCard">
                                        <core:HTML content="&lt;div onclick='sap.ui.controller(&quot;asset.lifecycle.portal.managerportal.managerportal.controller.View1&quot;).onEmployeesTilePress()' style='height:100%; display:flex; flex-direction:column; justify-content:space-between; cursor:pointer;'&gt;&lt;div&gt;&lt;div class='kpi-title'&gt;Total Employees&lt;/div&gt;&lt;div class='kpi-subtitle'&gt;All registered staff&lt;/div&gt;&lt;/div&gt;&lt;div class='kpi-bottom'&gt;&lt;span class='kpi-icon'&gt;&amp;#128101;&lt;/span&gt;&lt;span class='kpi-number'&gt;{kpi&gt;/totalAssets}&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" />
                                    </VBox>

                                    <!-- 2. Pending Requests -->
                                    <VBox class="customKpiCard">
                                        <core:HTML content="&lt;div onclick='sap.ui.controller(&quot;asset.lifecycle.portal.managerportal.managerportal.controller.View1&quot;).onPendingTilePress()' style='height:100%; display:flex; flex-direction:column; justify-content:space-between; cursor:pointer;'&gt;&lt;div&gt;&lt;div class='kpi-title'&gt;Pending Requests&lt;/div&gt;&lt;div class='kpi-subtitle'&gt;Awaiting approval&lt;/div&gt;&lt;/div&gt;&lt;div class='kpi-bottom'&gt;&lt;span class='kpi-icon'&gt;&amp;#9203;&lt;/span&gt;&lt;span class='kpi-number'&gt;{kpi&gt;/availableAssets}&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" />
                                    </VBox>

                                    <!-- 3. Approved Requests -->
                                    <VBox class="customKpiCard">
                                        <core:HTML content="&lt;div onclick='sap.ui.controller(&quot;asset.lifecycle.portal.managerportal.managerportal.controller.View1&quot;).onApprovedTilePress()' style='height:100%; display:flex; flex-direction:column; justify-content:space-between; cursor:pointer;'&gt;&lt;div&gt;&lt;div class='kpi-title'&gt;Approved Requests&lt;/div&gt;&lt;div class='kpi-subtitle'&gt;Ready for allocation&lt;/div&gt;&lt;/div&gt;&lt;div class='kpi-bottom'&gt;&lt;span class='kpi-icon'&gt;&amp;#9989;&lt;/span&gt;&lt;span class='kpi-number'&gt;{kpi&gt;/assignedAssets}&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" />
                                    </VBox>

                                    <!-- 4. Rejected Requests -->
                                    <VBox class="customKpiCard">
                                        <core:HTML content="&lt;div onclick='sap.ui.controller(&quot;asset.lifecycle.portal.managerportal.managerportal.controller.View1&quot;).onRejectedTilePress()' style='height:100%; display:flex; flex-direction:column; justify-content:space-between; cursor:pointer;'&gt;&lt;div&gt;&lt;div class='kpi-title'&gt;Rejected Requests&lt;/div&gt;&lt;div class='kpi-subtitle'&gt;Declined by manager&lt;/div&gt;&lt;/div&gt;&lt;div class='kpi-bottom'&gt;&lt;span class='kpi-icon'&gt;&amp;#10060;&lt;/span&gt;&lt;span class='kpi-number'&gt;{kpi&gt;/maintenanceAssets}&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" />
                                    </VBox>

                                    <!-- 5. Available Assets -->
                                    <VBox class="customKpiCard">
                                        <core:HTML content="&lt;div onclick='sap.ui.controller(&quot;asset.lifecycle.portal.managerportal.managerportal.controller.View1&quot;).onAvailableAssetsPress()' style='height:100%; display:flex; flex-direction:column; justify-content:space-between; cursor:pointer;'&gt;&lt;div&gt;&lt;div class='kpi-title'&gt;Available Assets&lt;/div&gt;&lt;div class='kpi-subtitle'&gt;Ready to assign&lt;/div&gt;&lt;/div&gt;&lt;div class='kpi-bottom'&gt;&lt;span class='kpi-icon'&gt;&amp;#128187;&lt;/span&gt;&lt;span class='kpi-number'&gt;{kpi&gt;/retiredAssets}&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" />
                                    </VBox>

                                    <!-- 6. Assigned Assets -->
                                    <VBox class="customKpiCard">
                                        <core:HTML content="&lt;div onclick='sap.ui.controller(&quot;asset.lifecycle.portal.managerportal.managerportal.controller.View1&quot;).onAssignedAssetsPress()' style='height:100%; display:flex; flex-direction:column; justify-content:space-between; cursor:pointer;'&gt;&lt;div&gt;&lt;div class='kpi-title'&gt;Assigned Assets&lt;/div&gt;&lt;div class='kpi-subtitle'&gt;Currently in use&lt;/div&gt;&lt;/div&gt;&lt;div class='kpi-bottom'&gt;&lt;span class='kpi-icon'&gt;&amp;#128279;&lt;/span&gt;&lt;span class='kpi-number'&gt;{kpi&gt;/archivedAssets}&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" />
                                    </VBox>

                                </HBox>
                            </VBox>

                            <!-- CHART ROW -->
                            <HBox
                                id="chartRow"
                                class="chartRow"
                                wrap="Wrap">

                                <!-- STATUS CHART -->
                                <VBox
                                    id="statusBox"
                                    class="chartCard">
                                    <Title
                                        id="statusTitle"
                                        text="Requests By Status"
                                        level="H2"
                                        class="sectionTitle" />
                                    <viz:VizFrame
                                        id="statusChart"
                                        vizType="donut"
                                        width="100%"
                                        height="350px">
                                        <viz:dataset>
                                            <viz.data:FlattenedDataset
                                                id="statusDataset"
                                                data="{status>/}">
                                                <viz.data:dimensions>
                                                    <viz.data:DimensionDefinition
                                                        id="statusDimension"
                                                        name="Status"
                                                        value="{status>status}" />
                                                </viz.data:dimensions>
                                                <viz.data:measures>
                                                    <viz.data:MeasureDefinition
                                                        id="statusMeasure"
                                                        name="Requests"
                                                        value="{status>assetCount}" />
                                                </viz.data:measures>
                                            </viz.data:FlattenedDataset>
                                        </viz:dataset>
                                        <viz:feeds>
                                            <viz.feeds:FeedItem
                                                id="statusSizeFeed"
                                                uid="size"
                                                type="Measure"
                                                values="Requests"/>
                                            <viz.feeds:FeedItem
                                                id="statusColorFeed"
                                                uid="color"
                                                type="Dimension"
                                                values="Status" />
                                        </viz:feeds>
                                    </viz:VizFrame>
                                </VBox>

                                <!-- CATEGORY CHART -->
                                <VBox
                                    id="categoryBox"
                                    class="chartCard">
                                    <Title
                                        id="categoryTitle"
                                        text="Requests By Category"
                                        level="H2"
                                        class="sectionTitle" />
                                    <viz:VizFrame
                                        id="categoryChart"
                                        vizType="column"
                                        width="100%"
                                        height="350px">
                                        <viz:dataset>
                                            <viz.data:FlattenedDataset
                                                id="categoryDataset"
                                                data="{category>/}">
                                                <viz.data:dimensions>
                                                    <viz.data:DimensionDefinition
                                                        id="categoryDimension"
                                                        name="Category"
                                                        value="{category>categoryName}" />
                                                </viz.data:dimensions>
                                                <viz.data:measures>
                                                    <viz.data:MeasureDefinition
                                                        id="categoryMeasure"
                                                        name="Requests"
                                                        value="{category>assetCount}" />
                                                </viz.data:measures>
                                            </viz.data:FlattenedDataset>
                                        </viz:dataset>
                                        <viz:feeds>
                                            <viz.feeds:FeedItem
                                                id="categoryValueFeed"
                                                uid="valueAxis"
                                                type="Measure"
                                                values="Requests" />
                                            <viz.feeds:FeedItem
                                                id="categoryDimensionFeed"
                                                uid="categoryAxis"
                                                type="Dimension"
                                                values="Category" />
                                        </viz:feeds>
                                    </viz:VizFrame>
                                </VBox>

                            </HBox>

                            <!-- DEPARTMENT CHART -->
                            <VBox
                                id="departmentBox"
                                class="chartCard fullWidthChart">
                                <Title
                                    id="departmentTitle"
                                    text="Requests By Department"
                                    level="H2"
                                    class="sectionTitle" />
                                <viz:VizFrame
                                    id="departmentChart"
                                    vizType="bar"
                                    width="100%"
                                    height="350px">
                                    <viz:dataset>
                                        <viz.data:FlattenedDataset
                                            id="departmentDataset"
                                            data="{department>/}">
                                            <viz.data:dimensions>
                                                <viz.data:DimensionDefinition
                                                    id="departmentDimension"
                                                    name="Department"
                                                    value="{department>departmentName}" />
                                            </viz.data:dimensions>
                                            <viz.data:measures>
                                                <viz.data:MeasureDefinition
                                                    id="departmentMeasure"
                                                    name="Requests"
                                                    value="{department>assetCount}" />
                                            </viz.data:measures>
                                        </viz.data:FlattenedDataset>
                                    </viz:dataset>
                                    <viz:feeds>
                                        <viz.feeds:FeedItem
                                            id="departmentValueFeed"
                                            uid="valueAxis"
                                            type="Measure"
                                            values="Requests" />
                                        <viz.feeds:FeedItem
                                            id="departmentCategoryFeed"
                                            uid="categoryAxis"
                                            type="Dimension"
                                            values="Department" />
                                    </viz:feeds>
                                </viz:VizFrame>
                            </VBox>

                        </VBox>

                        <!-- EMPLOYEES -->
                        <VBox id="employeesContainer" visible="false" class="tableContainer">
                            <Title text="Employee Management" class="sectionTitle" />
                            <Toolbar class="customToolbar">
                                <Button text="Create Employee" icon="sap-icon://add" type="Emphasized" press=".onCreateEmployee" />
                                <Button text="Edit Selected" icon="sap-icon://edit" type="Attention" press=".onEditEmployee" />
                                <ToolbarSpacer />
                                <SearchField width="300px" liveChange=".onEmployeeSearch" placeholder="Search Employee" />
                            </Toolbar>
                            <Table id="employeeTable" mode="SingleSelectMaster" includeItemInSelection="true" growing="true" sticky="ColumnHeaders" items="{employees>/}">
                                <columns>
                                    <Column><Text text="Employee Number" /></Column>
                                    <Column><Text text="Full Name" /></Column>
                                    <Column><Text text="Email" /></Column>
                                    <Column><Text text="Role" /></Column>
                                </columns>
                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <Text text="{employees>employeeNumber}" />
                                            <Text text="{employees>fullName}" />
                                            <Text text="{employees>email}" />
                                            <Text text="{employees>role}" />
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </VBox>

                        <!-- REQUESTS -->
                        <VBox id="requestsContainer" visible="false" class="tableContainer">
                            <Title id="requestTitle" text="Asset Requests" class="sectionTitle" />
                            <Toolbar id="requestToolbar" class="customToolbar">
                                <Button id="createRequestBtn" text="Create Request" icon="sap-icon://add" type="Emphasized" press=".onCreateRequest" />
                                <Button id="refreshRequestBtn" text="Refresh" icon="sap-icon://refresh" press=".onRefreshRequests" />
                                <ToolbarSpacer id="requestToolbarSpacer" />
                                <SearchField id="requestSearch" width="300px" liveChange=".onRequestSearch" placeholder="Search Request" />
                            </Toolbar>
                            <Table id="requestTable" growing="true" sticky="ColumnHeaders" items="{requests>/}">
                                <columns>
                                    <Column id="requestCol1"><Text id="requestHdr1" text="Employee" /></Column>
                                    <Column id="requestCol2"><Text id="requestHdr2" text="Category" /></Column>
                                    <Column id="requestCol3"><Text id="requestHdr3" text="Justification" /></Column>
                                    <Column id="requestCol4"><Text id="requestHdr4" text="Status" /></Column>
                                    <Column id="requestCol5"><Text id="requestHdr5" text="Approval Date" /></Column>
                                </columns>
                                <items>
                                    <ColumnListItem id="requestRowTemplate">
                                        <cells>
                                            <Text id="requestCell1" text="{requests>employeeName}" />
                                            <Text id="requestCell2" text="{requests>categoryName}" />
                                            <Text id="requestCell3" text="{requests>justification}" />
                                            <ObjectStatus id="requestCell4" text="{requests>status}" state="{= ${requests>status} === 'APPROVED' ? 'Success' : ${requests>status} === 'REJECTED' ? 'Error' : 'Warning' }" />
                                            <Text id="requestCell5" text="{requests>approvalDate}" />
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </VBox>

                        <!-- ASSETS -->
                        <VBox id="assetsContainer" visible="false" class="tableContainer">
                            <Title id="assetsTitle" text="Asset Inventory" class="sectionTitle" />
                            <Toolbar id="assetToolbar" class="customToolbar">
                                <Button id="refreshAssetsBtn" text="Refresh" icon="sap-icon://refresh" press=".onRefreshAssets" />
                                <ToolbarSpacer id="assetToolbarSpacer" />
                                <SearchField id="assetSearch" width="300px" liveChange=".onAssetSearch" placeholder="Search Asset" />
                            </Toolbar>
                            <Table id="assetTable" growing="true" sticky="ColumnHeaders" items="{assets>/}">
                                <columns>
                                    <Column id="assetCol1"><Text id="assetHdr1" text="Asset Tag" /></Column>
                                    <Column id="assetCol2"><Text id="assetHdr2" text="Model" /></Column>
                                    <Column id="assetCol3"><Text id="assetHdr3" text="Status" /></Column>
                                    <Column id="assetCol4"><Text id="assetHdr4" text="Serial Number" /></Column>
                                </columns>
                                <items>
                                    <ColumnListItem id="assetRowTemplate">
                                        <cells>
                                            <Text id="assetCell1" text="{assets>assetTag}" />
                                            <Text id="assetCell2" text="{assets>model}" />
                                            <ObjectStatus id="assetCell3" text="{assets>status}" state="{= ${assets>status} === 'AVAILABLE' ? 'Success' : ${assets>status} === 'ASSIGNED' ? 'Information' : ${assets>status} === 'MAINTENANCE' ? 'Warning' : 'Error' }" />
                                            <Text id="assetCell4" text="{assets>serialNumber}" />
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </VBox>

                        <!-- ASSET ALLOCATION -->
                        <VBox id="allocationContainer" visible="false" class="tableContainer">
                            <Title id="allocationTitle" text="Asset Allocation" class="sectionTitle" />
                            <Toolbar class="customToolbar">
                                <Button id="assignApprovedAssetBtn" text="Assign Approved Request" icon="sap-icon://employee" type="Accept" press=".onAssignApprovedAsset" />
                                <ToolbarSpacer />
                            </Toolbar>
                            <Table id="allocationTable" mode="SingleSelectMaster" includeItemInSelection="true" items="{approvedRequests>/}">
                                <columns>
                                    <Column><Text text="Employee" /></Column>
                                    <Column><Text text="Category" /></Column>
                                    <Column><Text text="Status" /></Column>
                                </columns>
                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <Text text="{approvedRequests>employeeName}" />
                                            <Text text="{approvedRequests>categoryName}" />
                                            <ObjectStatus text="{approvedRequests>status}" />
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </VBox>

                    </Panel>
                </VBox>
            </HBox>
        </content>
    </Page>
</mvc:View>