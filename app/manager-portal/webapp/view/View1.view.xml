<mvc:View
    controllerName="asset.lifecycle.portal.managerportal.managerportal.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.data="sap.viz.ui5.data"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds">

    <Page
        id="managerPage"
        title="Manager Portal">

        <content>

    <HBox
        id="mainLayout"
        width="100%">

                <!-- NAVIGATION -->

                <List
                    id="navigationMenu"
                    width="300px"
                    mode="SingleSelectMaster"
                    selectionChange=".onMenuSelect">

                    <StandardListItem
                        title="Dashboard"
                        icon="sap-icon://home" />

                    <StandardListItem
                        title="Employees"
                        icon="sap-icon://employee" />

                    <StandardListItem
                        title="Asset Requests"
                        icon="sap-icon://workflow-tasks" />

                    <StandardListItem
                        title="Assets"
                        icon="sap-icon://laptop" />

                    <StandardListItem
                        title="Asset Allocation"
                        icon="sap-icon://employee" />

                </List>

                <!-- CONTENT -->

                <VBox
                    width="100%"
                    class="sapUiResponsiveContentPadding">

                    <Title
                        id="contentTitle"
                        text="Dashboard"
                        level="H1" />

                    <Text
                        id="contentText"
                        text="Manager Dashboard" />

                    <Panel width="100%">

                        <!-- DASHBOARD -->

                        <VBox
                            id="dashboardContainer"
                            visible="true">

                            <!-- HEADER -->
                            <VBox
                                id="headerBox"
                                class="dashboardHeader">
                                <Title
                                    id="dashboardTitle"
                                    text="Manager Operations Dashboard"
                                    level="H1"/>
                                <Text
                                    id="dashboardSubTitle"
                                    text="Real-Time Employee Management, Asset Requests and Asset Visibility"/>
                            </VBox>

                            <!-- KPI SECTION -->
                            <VBox
                                id="dashboardVBox"
                                class="sapUiMediumMargin">
                                <Title
                                    id="overviewTitle"
                                    text="Manager Overview"
                                    level="H2"/>
                                <HBox
                                    id="kpiHBox"
                                    justifyContent="Center"
                                    wrap="Wrap">

                                    <GenericTile
                                        id="tileTotal"
                                        header="Total Employees"
                                        press=".onEmployeesTilePress">
                                        <TileContent>
                                            <NumericContent value="{kpi>/totalAssets}" />
                                        </TileContent>
                                    </GenericTile>

                                    <GenericTile
                                        id="tileAvailable"
                                        press=".onPendingTilePress"
                                        header="Pending Requests">
                                        <TileContent>
                                            <NumericContent value="{kpi>/availableAssets}" />
                                        </TileContent>
                                    </GenericTile>

                                    <GenericTile
                                        id="tileAssigned"
                                        press=".onApprovedTilePress"
                                        header="Approved Requests">
                                        <TileContent>
                                            <NumericContent value="{kpi>/assignedAssets}" />
                                        </TileContent>
                                    </GenericTile>

                                    <GenericTile
                                        id="tileMaintenance"
                                        press=".onRejectedTilePress"
                                        header="Rejected Requests">
                                        <TileContent>
                                            <NumericContent value="{kpi>/maintenanceAssets}" />
                                        </TileContent>
                                    </GenericTile>

                                    <GenericTile
                                        id="tileRetired"
                                        header="Available Assets"
                                        press=".onAvailableAssetsPress">
                                        <TileContent>
                                            <NumericContent value="{kpi>/retiredAssets}" />
                                        </TileContent>
                                    </GenericTile>

                                    <GenericTile
                                        id="tileArchived"
                                        header="Assigned Assets"
                                        press=".onAssignedAssetsPress">
                                        <TileContent>
                                            <NumericContent value="{kpi>/archivedAssets}" />
                                        </TileContent>
                                    </GenericTile>

                                </HBox>
                            </VBox>

                            <!-- CHART ROW -->
                            <HBox
                                id="chartRow"
                                justifyContent="SpaceAround"
                                wrap="Wrap">

                                <!-- STATUS CHART -->
                                <VBox
                                    id="statusBox"
                                    width="48%">
                                    <Title
                                        id="statusTitle"
                                        text="Requests By Status"
                                        level="H2" />
                                    <viz:VizFrame
                                        id="statusChart"
                                        vizType="donut"
                                        width="100%"
                                        height="400px">
                                        <viz:dataset>
                                            <viz.data:FlattenedDataset
                                                id="statusDataset"
                                                data="{status>/}">
                                                <viz.data:dimensions>
                                                    <viz.data:DimensionDefinition
                                                        id="statusDimension"
                                                        name="Status"
                                                        value="{status>status}" />
                                                </viz.data:dimensions>
                                                <viz.data:measures>
                                                    <viz.data:MeasureDefinition
                                                        id="statusMeasure"
                                                        name="Requests"
                                                        value="{status>assetCount}" />
                                                </viz.data:measures>
                                            </viz.data:FlattenedDataset>
                                        </viz:dataset>
                                        <viz:feeds>
                                            <viz.feeds:FeedItem
                                                id="statusSizeFeed"
                                                uid="size"
                                                type="Measure"
                                                values="Requests"/>
                                            <viz.feeds:FeedItem
                                                id="statusColorFeed"
                                                uid="color"
                                                type="Dimension"
                                                values="Status" />
                                        </viz:feeds>
                                    </viz:VizFrame>
                                </VBox>

                                <!-- CATEGORY CHART -->
                                <VBox
                                    id="categoryBox"
                                    width="48%">
                                    <Title
                                        id="categoryTitle"
                                        text="Requests By Category"
                                        level="H2" />
                                    <viz:VizFrame
                                        id="categoryChart"
                                        vizType="column"
                                        width="100%"
                                        height="400px">
                                        <viz:dataset>
                                            <viz.data:FlattenedDataset
                                                id="categoryDataset"
                                                data="{category>/}">
                                                <viz.data:dimensions>
                                                    <viz.data:DimensionDefinition
                                                        id="categoryDimension"
                                                        name="Category"
                                                        value="{category>categoryName}" />
                                                </viz.data:dimensions>
                                                <viz.data:measures>
                                                    <viz.data:MeasureDefinition
                                                        id="categoryMeasure"
                                                        name="Requests"
                                                        value="{category>assetCount}" />
                                                </viz.data:measures>
                                            </viz.data:FlattenedDataset>
                                        </viz:dataset>
                                        <viz:feeds>
                                            <viz.feeds:FeedItem
                                                id="categoryValueFeed"
                                                uid="valueAxis"
                                                type="Measure"
                                                values="Requests" />
                                            <viz.feeds:FeedItem
                                                id="categoryDimensionFeed"
                                                uid="categoryAxis"
                                                type="Dimension"
                                                values="Category" />
                                        </viz:feeds>
                                    </viz:VizFrame>
                                </VBox>

                            </HBox>

                            <!-- DEPARTMENT CHART -->
                            <VBox
                                id="departmentBox"
                                class="sapUiMediumMarginTop">
                                <Title
                                    id="departmentTitle"
                                    text="Requests By Department"
                                    level="H2" />
                                <viz:VizFrame
                                    id="departmentChart"
                                    vizType="bar"
                                    width="100%"
                                    height="400px">
                                    <viz:dataset>
                                        <viz.data:FlattenedDataset
                                            id="departmentDataset"
                                            data="{department>/}">
                                            <viz.data:dimensions>
                                                <viz.data:DimensionDefinition
                                                    id="departmentDimension"
                                                    name="Department"
                                                    value="{department>departmentName}" />
                                            </viz.data:dimensions>
                                            <viz.data:measures>
                                                <viz.data:MeasureDefinition
                                                    id="departmentMeasure"
                                                    name="Requests"
                                                    value="{department>assetCount}" />
                                            </viz.data:measures>
                                        </viz.data:FlattenedDataset>
                                    </viz:dataset>
                                    <viz:feeds>
                                        <viz.feeds:FeedItem
                                            id="departmentValueFeed"
                                            uid="valueAxis"
                                            type="Measure"
                                            values="Requests" />
                                        <viz.feeds:FeedItem
                                            id="departmentCategoryFeed"
                                            uid="categoryAxis"
                                            type="Dimension"
                                            values="Department" />
                                    </viz:feeds>
                                </viz:VizFrame>
                            </VBox>

                        </VBox>

                        <!-- EMPLOYEES -->

<!-- EMPLOYEES -->

<VBox
    id="employeesContainer"
    visible="false">

    <Title
        text="Employee Management" />

    <Toolbar>

        <Button
            text="Create Employee"
            icon="sap-icon://add"
            type="Emphasized"
            press=".onCreateEmployee" />

        <Button
            text="Edit Selected"
            icon="sap-icon://edit"
            type="Attention"
            press=".onEditEmployee" />

        <ToolbarSpacer />

        <SearchField
            width="300px"
            liveChange=".onEmployeeSearch"
            placeholder="Search Employee" />

    </Toolbar>

    <Table
        id="employeeTable"
        mode="SingleSelectMaster"
        includeItemInSelection="true"
        growing="true"
        sticky="ColumnHeaders"
        items="{employees>/}">

        <columns>

            <Column>
                <Text text="Employee Number" />
            </Column>

            <Column>
                <Text text="Full Name" />
            </Column>

            <Column>
                <Text text="Email" />
            </Column>

            <Column>
                <Text text="Role" />
            </Column>

        </columns>

        <items>

            <ColumnListItem>

                <cells>

                    <Text
                        text="{employees>employeeNumber}" />

                    <Text
                        text="{employees>fullName}" />

                    <Text
                        text="{employees>email}" />

                    <Text
                        text="{employees>role}" />

                </cells>

            </ColumnListItem>

        </items>

    </Table>

</VBox>

                        <!-- REQUESTS -->

<VBox
    id="requestsContainer"
    visible="false">

    <Title
        id="requestTitle"
        text="Asset Requests" />

    <Toolbar
        id="requestToolbar">

        <Button
            id="createRequestBtn"
            text="Create Request"
            icon="sap-icon://add"
            type="Emphasized"
            press=".onCreateRequest" />


        <Button
            id="refreshRequestBtn"
            text="Refresh"
            icon="sap-icon://refresh"
            press=".onRefreshRequests" />

        <ToolbarSpacer
            id="requestToolbarSpacer" />

        <SearchField
            id="requestSearch"
            width="300px"
            liveChange=".onRequestSearch"
            placeholder="Search Request" />

    </Toolbar>

    <Table
        id="requestTable"
        growing="true"
        sticky="ColumnHeaders"
        items="{requests>/}">

        <columns>

            <Column id="requestCol1">
                <Text id="requestHdr1" text="Employee" />
            </Column>

            <Column id="requestCol2">
                <Text id="requestHdr2" text="Category" />
            </Column>

            <Column id="requestCol3">
                <Text id="requestHdr3" text="Justification" />
            </Column>

            <Column id="requestCol4">
                <Text id="requestHdr4" text="Status" />
            </Column>

            <Column id="requestCol5">
                <Text id="requestHdr5" text="Approval Date" />
            </Column>

        </columns>

        <items>

            <ColumnListItem id="requestRowTemplate">

                <cells>

                    <Text
                        id="requestCell1"
                        text="{requests>employeeName}" />

                    <Text
                        id="requestCell2"
                        text="{requests>categoryName}" />

                    <Text
                        id="requestCell3"
                        text="{requests>justification}" />

<ObjectStatus
    id="requestCell4"
    text="{requests>status}"
    state="{= ${requests>status} === 'APPROVED' ? 'Success' : ${requests>status} === 'REJECTED' ? 'Error' : 'Warning' }" />

                    <Text
                        id="requestCell5"
                        text="{requests>approvalDate}" />

                </cells>

            </ColumnListItem>

        </items>

    </Table>

</VBox>

                        <!-- ASSETS -->

<VBox
    id="assetsContainer"
    visible="false">

    <Title
        id="assetsTitle"
        text="Asset Inventory" />

    <Toolbar
        id="assetToolbar">

        <Button
            id="refreshAssetsBtn"
            text="Refresh"
            icon="sap-icon://refresh"
            press=".onRefreshAssets" />

        <ToolbarSpacer
            id="assetToolbarSpacer" />

        <SearchField
            id="assetSearch"
            width="300px"
            liveChange=".onAssetSearch"
            placeholder="Search Asset" />

    </Toolbar>

    <Table
        id="assetTable"
        growing="true"
        sticky="ColumnHeaders"
        items="{assets>/}">

        <columns>

            <Column id="assetCol1">
                <Text id="assetHdr1" text="Asset Tag" />
            </Column>

            <Column id="assetCol2">
                <Text id="assetHdr2" text="Model" />
            </Column>

            <Column id="assetCol3">
                <Text id="assetHdr3" text="Status" />
            </Column>

            <Column id="assetCol4">
                <Text id="assetHdr4" text="Serial Number" />
            </Column>

        </columns>

        <items>

            <ColumnListItem id="assetRowTemplate">

                <cells>

                    <Text
                        id="assetCell1"
                        text="{assets>assetTag}" />

                    <Text
                        id="assetCell2"
                        text="{assets>model}" />

                    <ObjectStatus
                        id="assetCell3"
                        text="{assets>status}"
                        state="{
                            = ${assets>status} === 'AVAILABLE'
                            ? 'Success'
                            : ${assets>status} === 'ASSIGNED'
                            ? 'Information'
                            : ${assets>status} === 'MAINTENANCE'
                            ? 'Warning'
                            : 'Error'
                        }" />

                    <Text
                        id="assetCell4"
                        text="{assets>serialNumber}" />

                </cells>

            </ColumnListItem>

        </items>

    </Table>

</VBox>
    <VBox
    id="allocationContainer"
    visible="false">

    <Title
        id="allocationTitle"
        text="Asset Allocation" />

    <Toolbar>

        <Button
            id="assignApprovedAssetBtn"
            text="Assign Approved Request"
            icon="sap-icon://employee"
            type="Accept"
            press=".onAssignApprovedAsset" />

        <ToolbarSpacer />

    </Toolbar>

<Table
    id="allocationTable"
    mode="SingleSelectMaster"
    includeItemInSelection="true"
    items="{approvedRequests>/}">

        <columns>

            <Column>
                <Text text="Employee" />
            </Column>

            <Column>
                <Text text="Category" />
            </Column>

            <Column>
                <Text text="Status" />
            </Column>

        </columns>

        <items>

            <ColumnListItem>

                <cells>

                  <Text
    text="{approvedRequests>employeeName}" />


                   <Text
    text="{approvedRequests>categoryName}" />

                    <ObjectStatus
    text="{approvedRequests>status}" />

                </cells>

            </ColumnListItem>

        </items>

    </Table>

</VBox>

                    </Panel>

                </VBox>

            </HBox>

        </content>

    </Page>

</mvc:View>